{
  "manifest_version": 3,
  "name": "Highlight Paragraphs",
  "version": "1.0.0",
  "description": "Destaca todos os parágrafos da página atual.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Destacar parágrafos",
    "default_popup": "popup/popup.html"
  }
}
